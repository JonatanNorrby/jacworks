{
  "name": "jacworks-prototype-01",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n client,server \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build --configLoader native",
    "start": "tsx server/index.ts",
    "dev:cloudflare": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --import ./scripts/test-register.mjs --test shared/*.test.ts",
    "smoke": "node scripts/smoke-combat.mjs && node scripts/smoke-vote-totems.mjs && node scripts/smoke-rooms.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@babylonjs/core": "^8.0.0",
    "@babylonjs/loaders": "^8.56.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
